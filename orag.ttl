@prefix orag:    <https://ontorag.org/vocab#> .
@prefix orp:     <https://ontorag.org/provenance#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix void:    <http://rdfs.org/ns/void#> .

#################################################################
# Ontology
#################################################################

<https://ontorag.org/vocab>
    a owl:Ontology ;
    dcterms:title "OntoRAG Build Vocabulary"@en ;
    dcterms:description """Describes what an OntoRAG pipeline produces and how: datasets, schema cards and
exported ontologies, instance graphs, retrieval indexes, the build runs that made them, the baseline
ontologies a schema was aligned to, and the governance status of each artifact. Where a knowledge-graph
resource comes from in a source document, and how packs of a dataset are composed, is described by the
companion OntoRAG Provenance and Citation Ontology (orp:)."""@en ;
    dcterms:creator "Marco Montanari" ;
    dcterms:publisher <https://ontorag.org> ;
    dcterms:created "2026-02-28"^^xsd:date ;
    dcterms:modified "2026-09-23"^^xsd:date ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:versionInfo "0.2.0" ;
    owl:versionIRI <https://ontorag.org/vocab/0.2.0> ;
    owl:priorVersion <https://www.ontorag.org/vocab> ;
    vann:preferredNamespacePrefix "orag" ;
    vann:preferredNamespaceUri "https://ontorag.org/vocab#" ;
    rdfs:seeAlso <https://ontorag.org/provenance> , <https://github.com/ontorag/vocab> .

#################################################################
# Datasets
#################################################################

orag:Dataset
    a owl:Class ;
    rdfs:label "Dataset"@en ;
    rdfs:subClassOf void:Dataset , prov:Entity ;
    rdfs:comment """A published OntoRAG dataset: a versioned, self-describing bundle of an ontology, an
instance graph, content chunks and embeddings, usually stored as a git repository and described by a
manifest.json that follows the OntoRAG dataset format. Its per-source slices are orp:Pack resources,
linked with void:subset."""@en .

orag:manifest
    a owl:ObjectProperty ;
    rdfs:label "manifest"@en ;
    rdfs:domain orag:Dataset ;
    rdfs:comment "The dataset's manifest.json, which declares its layout, formats and embedding configuration."@en .

orag:specVersion
    a owl:DatatypeProperty ;
    rdfs:label "spec version"@en ;
    rdfs:domain orag:Dataset ;
    rdfs:range xsd:string ;
    rdfs:comment "Version of the OntoRAG dataset format the dataset conforms to (the manifest's \"ontorag\" field), e.g. \"0.1\"."@en .

#################################################################
# Artifacts
#################################################################

orag:Artifact
    a owl:Class ;
    rdfs:label "Artifact"@en ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment """A versioned, addressable output of an OntoRAG pipeline: a schema card, an exported
ontology, an instance graph, an index or a quality report. Source documents are not artifacts; they are
described as orp:SourceFile."""@en .

orag:SchemaCard
    a owl:Class ;
    rdfs:label "Schema card"@en ;
    rdfs:subClassOf orag:Artifact ;
    rdfs:comment """The governed schema of a dataset, as a JSON document listing its classes, properties,
events and aliases, each with the baseline it comes from or "induced". Language models propose changes to
it; a deterministic merge produces each new card; a human approves it before instances are extracted."""@en .

orag:OntologyArtifact
    a owl:Class ;
    rdfs:label "Ontology artifact"@en ;
    rdfs:subClassOf orag:Artifact ;
    rdfs:comment "The OWL/RDFS ontology exported from a schema card, e.g. ontology/schema.ttl."@en .

orag:GraphArtifact
    a owl:Class ;
    rdfs:label "Graph artifact"@en ;
    rdfs:subClassOf orag:Artifact ;
    rdfs:comment """A build of an instance graph, for a whole dataset or for one orp:Pack, stored as a
file (e.g. ontology/world.ttl) and/or loaded into a named graph."""@en .

orag:IndexArtifact
    a owl:Class ;
    rdfs:label "Index artifact"@en ;
    rdfs:subClassOf orag:Artifact ;
    rdfs:comment "A retrieval index built over a dataset's chunks or graph, such as an embedding store or a keyword index."@en .

orag:QualityReport
    a owl:Class ;
    rdfs:label "Quality report"@en ;
    rdfs:subClassOf orag:Artifact ;
    rdfs:comment "Validation results or metrics for an artifact: SHACL reports, coverage, evaluation scores."@en .

orag:checksum
    a owl:DatatypeProperty ;
    rdfs:label "checksum"@en ;
    rdfs:domain orag:Artifact ;
    rdfs:range xsd:string ;
    rdfs:comment "Content checksum written as \"<algorithm>:<lowercase hex digest>\", the same form as orp:checksum."@en .

orag:location
    a owl:DatatypeProperty ;
    rdfs:label "location"@en ;
    rdfs:domain orag:Artifact ;
    rdfs:range xsd:anyURI ;
    rdfs:comment "Where the artifact can be retrieved: a URL, or a path relative to the dataset root."@en .

orag:status
    a owl:ObjectProperty ;
    rdfs:label "status"@en ;
    rdfs:domain orag:Artifact ;
    rdfs:range orag:ArtifactStatus ;
    rdfs:comment "Governance status of the artifact."@en .

orag:accessPolicy
    a owl:ObjectProperty ;
    rdfs:label "access policy"@en ;
    rdfs:range orag:AccessPolicy ;
    rdfs:comment """Coarse visibility class of a dataset, pack or artifact. Who holds access to protected
content is decided by the serving application, not recorded here."""@en .

orag:dependsOn
    a owl:ObjectProperty ;
    rdfs:label "depends on"@en ;
    rdfs:domain orag:Artifact ;
    rdfs:range prov:Entity ;
    rdfs:comment """Build-time dependency: this artifact was produced from, or is only valid together with,
the other one (e.g. an instance graph depends on the schema card it was extracted against). Semantic
dependencies between packs are expressed with orp:requires."""@en .

orag:hasReport
    a owl:ObjectProperty ;
    rdfs:label "has report"@en ;
    rdfs:domain orag:Artifact ;
    rdfs:range orag:QualityReport ;
    rdfs:comment "A quality report about this artifact."@en .

orag:contentGraph
    a owl:ObjectProperty ;
    rdfs:label "content graph"@en ;
    rdfs:domain orag:GraphArtifact ;
    rdfs:comment "IRI of the named graph the graph artifact is loaded into."@en .

orag:buildOf
    a owl:ObjectProperty ;
    rdfs:label "build of"@en ;
    rdfs:domain orag:GraphArtifact ;
    rdfs:range void:Dataset ;
    rdfs:comment "The dataset or orp:Pack whose content this graph artifact is a build of."@en .

orag:hasIndex
    a owl:ObjectProperty ;
    rdfs:label "has index"@en ;
    rdfs:range orag:IndexArtifact ;
    rdfs:comment "An index built for this dataset or graph artifact."@en .

#################################################################
# Indexes
#################################################################

orag:indexMethod
    a owl:ObjectProperty ;
    rdfs:label "index method"@en ;
    rdfs:domain orag:IndexArtifact ;
    rdfs:range orag:IndexMethod ;
    rdfs:comment "The kind of index."@en .

orag:indexScope
    a owl:ObjectProperty ;
    rdfs:label "index scope"@en ;
    rdfs:domain orag:IndexArtifact ;
    rdfs:range orag:IndexScope ;
    rdfs:comment "The unit the index retrieves (chunk, section, page, document)."@en .

orag:embeddingModel
    a owl:DatatypeProperty ;
    rdfs:label "embedding model"@en ;
    rdfs:domain orag:IndexArtifact ;
    rdfs:range xsd:string ;
    rdfs:comment "Identifier of the embedding model, e.g. \"nomic-embed-text\". Queries must be embedded with the same model."@en .

orag:dimensions
    a owl:DatatypeProperty ;
    rdfs:label "dimensions"@en ;
    rdfs:domain orag:IndexArtifact ;
    rdfs:range xsd:integer ;
    rdfs:comment "Length of the embedding vectors."@en .

orag:similarityMetric
    a owl:DatatypeProperty ;
    rdfs:label "similarity metric"@en ;
    rdfs:domain orag:IndexArtifact ;
    rdfs:range xsd:string ;
    rdfs:comment "Similarity used to compare vectors, e.g. \"cosine\"."@en .

orag:citationPolicy
    a owl:ObjectProperty ;
    rdfs:label "citation policy"@en ;
    rdfs:domain orag:IndexArtifact ;
    rdfs:range orag:CitationPolicy ;
    rdfs:comment "How precisely results from this index can be cited back to their source."@en .

orag:params
    a owl:DatatypeProperty ;
    rdfs:label "parameters"@en ;
    rdfs:domain orag:IndexArtifact ;
    rdfs:range rdf:JSON ;
    rdfs:comment "Build parameters of the index (chunk size, overlap, quantisation…) as a JSON literal."@en .

#################################################################
# Build runs
#################################################################

orag:BuildRun
    a owl:Class ;
    rdfs:label "Build run"@en ;
    rdfs:subClassOf prov:Activity ;
    rdfs:comment """One execution of a pipeline stage. It consumes source files and earlier artifacts and
produces new artifacts. Record the software with prov:wasAssociatedWith and times with prov:startedAtTime
and prov:endedAtTime."""@en .

orag:stage
    a owl:ObjectProperty ;
    rdfs:label "stage"@en ;
    rdfs:domain orag:BuildRun ;
    rdfs:range orag:Stage ;
    rdfs:comment "The pipeline stage this run executed."@en .

orag:consumed
    a owl:ObjectProperty ;
    rdfs:label "consumed"@en ;
    rdfs:subPropertyOf prov:used ;
    rdfs:domain orag:BuildRun ;
    rdfs:range prov:Entity ;
    rdfs:comment "An input of the run: an orp:SourceFile, a baseline ontology or an earlier artifact."@en .

orag:produced
    a owl:ObjectProperty ;
    rdfs:label "produced"@en ;
    rdfs:subPropertyOf prov:generated ;
    rdfs:domain orag:BuildRun ;
    rdfs:range orag:Artifact ;
    rdfs:comment "An artifact the run produced."@en .

orag:pipelineVersion
    a owl:DatatypeProperty ;
    rdfs:label "pipeline version"@en ;
    rdfs:domain orag:BuildRun ;
    rdfs:range xsd:string ;
    rdfs:comment "Version of the software that ran the stage, e.g. \"ontorag 0.1.12\"."@en .

orag:languageModel
    a owl:DatatypeProperty ;
    rdfs:label "language model"@en ;
    rdfs:domain orag:BuildRun ;
    rdfs:range xsd:string ;
    rdfs:comment "Identifier of the language model used by the run, if any, as given to the provider."@en .

#################################################################
# Baselines and alignment
#################################################################

orag:BaselineOntology
    a owl:Class ;
    rdfs:label "Baseline ontology"@en ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment """An existing ontology a schema is aligned to before anything new is induced (for
example rpg-schema, schema.org, FOAF). Identify it with dcterms:identifier (its catalog slug) and link its
namespace with vann:preferredNamespaceUri."""@en .

orag:alignedWith
    a owl:ObjectProperty ;
    rdfs:label "aligned with"@en ;
    rdfs:range orag:BaselineOntology ;
    rdfs:comment "A baseline ontology that this dataset, schema card or ontology artifact is aligned to."@en .

orag:alignmentRole
    a owl:ObjectProperty ;
    rdfs:label "alignment role"@en ;
    rdfs:domain orag:BaselineOntology ;
    rdfs:range orag:AlignmentRole ;
    rdfs:comment "Whether the baseline provides the domain schema or supporting vocabulary."@en .

orag:origin
    a owl:ObjectProperty ;
    rdfs:label "origin"@en ;
    rdfs:range orag:BaselineOntology ;
    rdfs:comment "For a class or property of an exported ontology: the baseline it was reused from or extends. Induced terms have no origin."@en .

orag:alignment
    a owl:ObjectProperty ;
    rdfs:label "alignment"@en ;
    rdfs:range orag:AlignmentDecision ;
    rdfs:comment "For a class or property of an exported ontology: how it relates to the baselines."@en .

#################################################################
# Controlled vocabularies
#################################################################

orag:ArtifactStatus a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "Artifact status"@en ;
    rdfs:comment "Governance status of an artifact."@en .
orag:Proposed a orag:ArtifactStatus ; skos:prefLabel "Proposed"@en ;
    skos:definition "Produced by the pipeline and awaiting human review."@en .
orag:Approved a orag:ArtifactStatus ; skos:prefLabel "Approved"@en ;
    skos:definition "Reviewed and accepted by a person; may be published and served."@en .
orag:Deprecated a orag:ArtifactStatus ; skos:prefLabel "Deprecated"@en ;
    skos:definition "Superseded by a newer artifact; kept for reproducibility."@en .
orag:Revoked a orag:ArtifactStatus ; skos:prefLabel "Revoked"@en ;
    skos:definition "Withdrawn; must not be served."@en .

orag:AccessPolicy a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "Access policy"@en ;
    rdfs:comment "Coarse visibility class."@en .
orag:Public a orag:AccessPolicy ; skos:prefLabel "Public"@en ;
    skos:definition "Anyone may read it."@en .
orag:Protected a orag:AccessPolicy ; skos:prefLabel "Protected"@en ;
    skos:definition "Readable only by consumers the serving application entitles, typically per pack."@en .
orag:Internal a orag:AccessPolicy ; skos:prefLabel "Internal"@en ;
    skos:definition "Only for the dataset's maintainers."@en .

orag:Stage a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "Stage"@en ;
    rdfs:comment "A step of the OntoRAG pipeline."@en .
orag:Ingest a orag:Stage ; skos:prefLabel "Ingest"@en ;
    skos:definition "Parse source files into documents and chunks."@en .
orag:ProposeSchema a orag:Stage ; skos:prefLabel "Propose schema"@en ;
    skos:definition "A language model proposes classes and properties from the chunks."@en .
orag:AlignSchema a orag:Stage ; skos:prefLabel "Align schema"@en ;
    skos:definition "A language model decides, per proposed term, to reuse, extend or add to the baselines."@en .
orag:BuildSchemaCard a orag:Stage ; skos:prefLabel "Build schema card"@en ;
    skos:definition "Deterministically merge the previous card with the aligned proposal."@en .
orag:ExportOntology a orag:Stage ; skos:prefLabel "Export ontology"@en ;
    skos:definition "Write the schema card as OWL/RDFS."@en .
orag:ExtractInstances a orag:Stage ; skos:prefLabel "Extract instances"@en ;
    skos:definition "Extract schema-constrained instances with provenance mentions."@en .
orag:BuildIndex a orag:Stage ; skos:prefLabel "Build index"@en ;
    skos:definition "Embed chunks and build retrieval indexes."@en .
orag:Publish a orag:Stage ; skos:prefLabel "Publish"@en ;
    skos:definition "Write the dataset and its manifest to its storage, e.g. a git repository."@en .

orag:IndexMethod a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "Index method"@en ;
    rdfs:comment "Kind of retrieval index."@en .
orag:DenseVectors a orag:IndexMethod ; skos:prefLabel "Dense vectors"@en ;
    skos:definition "Embedding vectors compared by similarity."@en .
orag:Keyword a orag:IndexMethod ; skos:prefLabel "Keyword"@en ;
    skos:definition "Sparse term index such as BM25."@en .
orag:EntityIndex a orag:IndexMethod ; skos:prefLabel "Entity index"@en ;
    skos:definition "Chunks retrieved through the ontology entities they mention."@en .
orag:TreeIndex a orag:IndexMethod ; skos:prefLabel "Tree index"@en ;
    skos:definition "Hierarchical document index navigated by reasoning (e.g. PageIndex)."@en .

orag:IndexScope a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "Index scope"@en ;
    rdfs:comment "Unit an index retrieves."@en .
orag:ChunkLevel a orag:IndexScope ; skos:prefLabel "Chunk"@en ;
    skos:definition "Retrieves chunks."@en .
orag:SectionLevel a orag:IndexScope ; skos:prefLabel "Section"@en ;
    skos:definition "Retrieves whole sections."@en .
orag:PageLevel a orag:IndexScope ; skos:prefLabel "Page"@en ;
    skos:definition "Retrieves pages."@en .
orag:DocumentLevel a orag:IndexScope ; skos:prefLabel "Document"@en ;
    skos:definition "Retrieves whole documents."@en .

orag:CitationPolicy a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "Citation policy"@en ;
    rdfs:comment "How precisely results can be cited back to their source."@en .
orag:PageAccurate a orag:CitationPolicy ; skos:prefLabel "Page-accurate"@en ;
    skos:definition "Every result carries an orp:PageSelector."@en .
orag:SectionAccurate a orag:CitationPolicy ; skos:prefLabel "Section-accurate"@en ;
    skos:definition "Every result carries an orp:SectionSelector but not always a page."@en .
orag:SourceOnly a orag:CitationPolicy ; skos:prefLabel "Source only"@en ;
    skos:definition "Results can be attributed to a source but not located within it."@en .

orag:AlignmentRole a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "Alignment role"@en ;
    rdfs:comment "What a baseline contributes to a schema."@en .
orag:DomainSchema a orag:AlignmentRole ; skos:prefLabel "Domain schema"@en ;
    skos:definition "The main domain ontology the schema builds on (e.g. rpg-schema)."@en .
orag:SupportingVocabulary a orag:AlignmentRole ; skos:prefLabel "Supporting vocabulary"@en ;
    skos:definition "A general vocabulary reused for common terms (e.g. schema.org, FOAF, Dublin Core)."@en .

orag:AlignmentDecision a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "Alignment decision"@en ;
    rdfs:comment "How a schema term relates to the baselines."@en .
orag:Reused a orag:AlignmentDecision ; skos:prefLabel "Reused"@en ;
    skos:definition "The term is a baseline term used as is."@en .
orag:Extended a orag:AlignmentDecision ; skos:prefLabel "Extended"@en ;
    skos:definition "The term is new but declared a sub-class or sub-property of a baseline term."@en .
orag:Induced a orag:AlignmentDecision ; skos:prefLabel "Induced"@en ;
    skos:definition "The term is new and has no counterpart in the baselines."@en .
